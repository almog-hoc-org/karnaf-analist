# Copy to .env.production on the server and fill in real values.
#   cp .env.example .env.production
#   ln -s .env.production .env        <-- REQUIRED, see below
#   nano .env.production
#
# WHY THE SYMLINK: docker-compose.yml interpolates ${APP_HOST} into the Traefik
# routing label when it PARSES the file, and Compose resolves such variables
# only from the shell environment or from a file named exactly `.env`. It does
# NOT read `env_file:` for this — that only sets variables inside the container.
# Without the symlink, a hand-run `docker compose up` builds the label
# Host(``) with an empty hostname, Traefik matches nothing, and every URL
# returns 404 while the container still reports itself healthy.
#
# .env.production is gitignored and excluded from the Docker image on purpose —
# it holds secrets, and an image can be pulled by anyone who can reach it.

# ── Where the site is served ────────────────────────────────────────
# The hostname Traefik routes to this app. Start with the free Hostinger
# hostname; move to a real domain later by changing this and re-running deploy.
APP_HOST=srv1773229.hstgr.cloud

# Absolute public URL. Used in notification emails, which are useless if they
# link to localhost.
KARNAF_SITE_URL=https://srv1773229.hstgr.cloud

# Sub-path, if the site ever moves under karnafnadlan.com/analist.
# EMPTY = served at the domain root. This is inlined into the browser bundle at
# BUILD time, so changing it requires a rebuild, not a restart.
NEXT_PUBLIC_BASE_PATH=

# ── Secrets — generate these, never reuse a password from elsewhere ──
# Admin dashboard password. Without it the dashboard is CLOSED, not open
# (lib/adminAuth.ts is fail-closed by design).
#   generate: openssl rand -base64 24
ADMIN_PASSWORD=

# Keeps admin sessions valid across restarts. Without it a new random secret is
# minted per process and every admin cookie is invalidated on redeploy.
#   generate: openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# Lets the nightly pipeline tell the running server its cached data is stale.
# Without it the pipeline still succeeds; it just cannot invalidate the cache,
# so pages stay up to 6h behind.
#   generate: openssl rand -hex 32
REVALIDATE_TOKEN=

# ── Pipeline → server ───────────────────────────────────────────────
# Where scripts/pipeline.ts posts after a successful run.
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate

# ── Analytics (optional) ────────────────────────────────────────────
# Microsoft Clarity project ID. LEAVE EMPTY until the privacy policy that
# discloses it is published and reviewed — no third-party script should reach a
# visitor before the notice describing it does.
#
# Clarity is never loaded on /deals, /admin, /login or /register, regardless of
# this value. See components/Analytics.tsx for why that is enforced in code
# rather than through Clarity's own masking settings.
#
# ⚠️ BUILD-TIME, like every NEXT_PUBLIC_* value: it is inlined into the browser
# bundle when the image is built. Setting it and restarting does nothing —
# run `bash scripts/deploy.sh` so the image is rebuilt with the new value.
NEXT_PUBLIC_CLARITY_ID=

# Persistent data directory INSIDE the container. The host path is bind-mounted
# in docker-compose.yml; do not change one without the other.
KARNAF_DATA_DIR=/app/data

# ── יציאה ישראלית לאיסוף מרשות המסים ──────────────────────────────
#
# govmap.gov.il and nadlan.gov.il sit behind CloudFront with a geo rule. From a
# server outside Israel EVERY path returns the same ~1.7KB HTML shell — the API
# and even a real static asset. Measured against the same URL at the same moment
# from a machine in Israel, which returns the genuine 10MB bundle: identical
# headers, only the egress differs.
#
# So this is not a changed endpoint and not User-Agent filtering, and a headless
# browser in the container cannot fix it — that browser cannot load the
# application either. The only thing that changes the answer is where the
# request leaves from.
#
# LEAVE IT EMPTY and the collectors behave exactly as they do now: plain fetch,
# no new failure mode, and govmap simply reports the geo-block instead of 168
# identical parse errors. Set it and the Tax Authority sources start working.
#
# Scoped on purpose — ONLY those two hosts route through it. The CBS and the
# Chief Economist are not restricted (19 publications arrived on the first run)
# and must not depend on a rented box to keep working.
#
#   KARNAF_IL_PROXY=http://user:pass@host:port
KARNAF_IL_PROXY=

# How many days before a city is collected again by the govmap collector.
# 20 suits a backfill (a fifth of the country a night, full rotation in three
# weeks). Lower it once real per-city timings are known — operating this by hand
# meant a daily run, because deals go missing and a re-run finds them.
KARNAF_GOVMAP_FRESH_DAYS=20

# ── התראות מייל ──────────────────────────────────────────────────
#
# Without these the feedback form still SAVES every submission — the database
# row is the source of truth — but nobody is told a message arrived. That was
# the state until now: a form that stores and never notifies, which from the
# sender's side is indistinguishable from one that discards.
#
# RESEND_API_KEY   from https://resend.com/api-keys  (free tier: 3,000/month)
# NOTIFY_TO_EMAIL  where feedback lands
# NOTIFY_FROM_EMAIL  MUST be on a domain verified in Resend. A visitor's own
#                  address here is rejected by SPF — their address goes in
#                  Reply-To instead, which the code already does.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=karnaf.yazamut@gmail.com
NOTIFY_FROM_EMAIL=

# ── כניסה עם גוגל (אופציונלי) ────────────────────────────────────
#
# Without these the Google buttons simply do not render — email+password keeps
# working. To enable: Google Cloud Console → APIs & Services → Credentials →
# Create OAuth client ID (Web application), and register the redirect URI:
#   <KARNAF_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── סנכרון דיוור ו-CRM (אופציונלי, מופעל ידנית מהאדמין) ─────────
#
# Rav Messer: only users who ticked mailing consent are ever sent.
RAVMESSER_API_KEY=
RAVMESSER_LIST_ID=

# karnaf-crm website-leads-intake Edge Function URL, e.g.
#   https://<project-ref>.functions.supabase.co/website-leads-intake
# Only users who provided a phone are sent (the intake requires one).
CRM_INTAKE_URL=
