# Copy to .env.production on the server and fill in real values.
#   cp .env.example .env.production
#   ln -s .env.production .env        <-- REQUIRED, see below
#   nano .env.production
#
# WHY THE SYMLINK: docker-compose.yml interpolates ${APP_HOST} into the Traefik
# routing label when it PARSES the file, and Compose resolves such variables
# only from the shell environment or from a file named exactly `.env`. It does
# NOT read `env_file:` for this — that only sets variables inside the container.
# Without the symlink, a hand-run `docker compose up` builds the label
# Host(``) with an empty hostname, Traefik matches nothing, and every URL
# returns 404 while the container still reports itself healthy.
#
# .env.production is gitignored and excluded from the Docker image on purpose —
# it holds secrets, and an image can be pulled by anyone who can reach it.

# ── Where the site is served ────────────────────────────────────────
# The hostname Traefik routes to this app. Start with the free Hostinger
# hostname; move to a real domain later by changing this and re-running deploy.
APP_HOST=srv1773229.hstgr.cloud

# Absolute public URL. Used in notification emails, which are useless if they
# link to localhost.
KARNAF_SITE_URL=https://srv1773229.hstgr.cloud

# Sub-path, if the site ever moves under karnafnadlan.com/analist.
# EMPTY = served at the domain root. This is inlined into the browser bundle at
# BUILD time, so changing it requires a rebuild, not a restart.
NEXT_PUBLIC_BASE_PATH=

# ── Secrets — generate these, never reuse a password from elsewhere ──
# Admin dashboard password. Without it the dashboard is CLOSED, not open
# (lib/adminAuth.ts is fail-closed by design).
#   generate: openssl rand -base64 24
ADMIN_PASSWORD=

# Keeps admin sessions valid across restarts. Without it a new random secret is
# minted per process and every admin cookie is invalidated on redeploy.
#   generate: openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# Lets the nightly pipeline tell the running server its cached data is stale.
# Without it the pipeline still succeeds; it just cannot invalidate the cache,
# so pages stay up to 6h behind.
#   generate: openssl rand -hex 32
REVALIDATE_TOKEN=

# ── Pipeline → server ───────────────────────────────────────────────
# Where scripts/pipeline.ts posts after a successful run.
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate

# Persistent data directory INSIDE the container. The host path is bind-mounted
# in docker-compose.yml; do not change one without the other.
KARNAF_DATA_DIR=/app/data
