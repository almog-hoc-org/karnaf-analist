generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model City {
  id                           Int              @id @default(autoincrement())
  city_name                    String           @unique
  population_2021              Int?
  population_2026              Int?
  people_per_apartment         Float?
  construction_4y_gross        Int?
  net_coefficient              Float?
  price_per_sqm_2023           Int?
  price_per_sqm_2026           Int?
  total_apartments             Float?
  construction_net             Float?
  population_growth_abs        Int?
  population_growth_pct        Float?
  apartments_required          Float?
  apartment_growth             Float?
  golden_multiplier            Float?
  golden_pct                   Float?
  price_change_pct             Float?
  last_updated                 DateTime         @default(now())
  urban_renewal_existing_units Int?
  urban_renewal_proposed_units Int?
  urban_renewal_status         String?
  population_2022              Int?             @map("population_2022")
  population_2024              Int?             @map("population_2024")
  households_2022              Int?             @map("households_2022")
  avgHouseholdSize2022         Float?           @map("avg_household_size_2022")
  building_permits             BuildingPermit[]
  cbs_press_data               CbsPressData[]
  sales                        CitySales?

  @@map("cities")
}

model CitySales {
  id                    Int      @id @default(autoincrement())
  city_name             String   @unique
  new_sales_2023        Int?
  new_sales_2024        Int?
  new_sales_2025        Int?
  unsold_inventory_2025 Int?
  avg_sales_3y          Float?
  years_to_clear_2025   Float?
  years_to_clear_avg    Float?
  last_updated          DateTime @default(now())
  city                  City     @relation(fields: [city_name], references: [city_name])

  @@map("city_sales")
}

model BuildingPermit {
  id           Int      @id @default(autoincrement())
  city_name    String
  year         Int
  permits      Int?
  source       String   @default("CBS_YISHUV")
  last_updated DateTime @default(now())
  city         City     @relation(fields: [city_name], references: [city_name])

  @@unique([city_name, year])
  @@map("building_permits")
}

model CbsPressData {
  id                       Int      @id @default(autoincrement())
  city_name                String
  year                     Int
  quarter                  Int?
  construction_starts      Int?
  construction_completions Int?
  source_url               String?
  publication_title        String?
  last_updated             DateTime @default(now())
  city                     City     @relation(fields: [city_name], references: [city_name])

  @@unique([city_name, year, quarter])
  @@map("cbs_press_data")
}

model nadlan_deals_summary {
  id                Int       @id @default(autoincrement())
  city_name         String
  year              Int
  quarter           Int
  deal_count        Int?      @default(0)
  avg_price_per_sqm Float?
  avg_deal_amount   Float?
  median_rooms      Float?
  last_updated      DateTime? @default(now())

  @@unique([city_name, year, quarter], map: "sqlite_autoindex_nadlan_deals_summary_1")
}

model nadlan_price_trends {
  id           Int     @id @default(autoincrement())
  city_name    String
  year         Int
  quarter      Int
  median_price Float?
  source       String? @default("nadlan.gov.il")

  @@unique([city_name, year, quarter], map: "sqlite_autoindex_nadlan_price_trends_1")
}

model population_by_year {
  id         Int     @id @default(autoincrement())
  city_name  String
  year       Int
  population Int?
  source     String? @default("interpolated")

  @@unique([city_name, year], map: "sqlite_autoindex_population_by_year_1")
}

// Multi-source population storage: same (city, year) can have multiple values
// from different sources (CBS census 2022, CBS yishuvim 2023, data.gov.il 2026,
// Bituach Leumi, projections, etc.). Lets the city page show source comparison.
model population_estimates {
  id          Int      @id @default(autoincrement())
  city_name   String
  year        Int
  source      String
  population  Int
  source_url  String?
  fetched_at  DateTime @default(now())

  @@unique([city_name, year, source])
  @@index([city_name])
  @@index([year])
}

model yad2_market_data {
  id                    Int       @id @default(autoincrement())
  city_name             String    @unique(map: "sqlite_autoindex_yad2_market_data_1")
  cbs_code              String?
  region                String?
  area                  String?
  new_properties        Int?
  secondhand_properties Int?
  avg_days_on_market    Int?
  buyers_count          Int?
  new_properties_yoy    Float?
  secondhand_yoy        Float?
  days_yoy              Float?
  buyers_yoy            Float?
  market_type           String?
  households            Int?
  avg_household_size    Float?
  // Yadata "מד השוק" — numeric market gauge (typical scale 1-100 or 0-10).
  // Higher = stronger sellers' market. Null when Yadata doesn't render it
  // for that city or our parser couldn't find the value.
  market_gauge          Float?
  // Yadata "מדד התפשרות" — average % gap between asking price and actual deal
  // price. Positive = sellers compromise (accept less than asked).
  compromise_index      Float?
  scraped_at            DateTime? @default(now())
}

model construction_starts {
  id        Int     @id @default(autoincrement())
  city_name String
  year      Int
  starts    Int
  source    String? @default("cbs_press_release_2025")

  @@unique([city_name, year], map: "sqlite_autoindex_construction_starts_1")
}

model national_construction {
  id          Int     @id @default(autoincrement())
  year        Int     @unique(map: "sqlite_autoindex_national_construction_1")
  permits     Int?
  starts      Int?
  completions Int?
  source      String?
}

// Raw audit trail: the sampled 3/4/5-room nadlan settlement deals (WITH build year),
// collected by paginating the "עסקאות אחרונות ביישוב" view. One row per kept deal.
// is_secondhand = deal_year - year_built >= secondhand_min_age (default 4). Source: nadlan.gov.il
// The threshold is the admin rule, not a literal — it said 3 here while every
// collector burned 4, because getRuleNum ignores a caller fallback for a
// declared key. scripts/recompute-secondhand.ts re-derives the column from it.
// (רשות המסים). Averages/medians are derived into nadlan_year_room_stats.
model nadlan_transactions {
  id            Int      @id @default(autoincrement())
  city_name     String
  cbs_code      String?
  deal_date     String
  deal_year     Int
  rooms         Float?
  room_bucket   String // "3" | "4" | "5"
  area          Float?
  price         Float?
  price_sqm     Float?
  year_built    Int?
  is_secondhand Boolean  @default(false)
  neighborhood  String?
  street        String?
  house_num     String?
  floor         String?  // govmap returns Hebrew floor names ("חמישית", "קומת קרקע")
  excluded         Int?    @default(0)
  exclusion_reason String?
  // A luxury deal is NOT excluded — it happened and is counted. It only leaves the
  // price statistics (scripts/flag-luxury-deals.ts). luxury_ratio keeps its ₪/m²
  // over the category median, so the flag can always be explained.
  luxury           Int?    @default(0)
  luxury_ratio     Float?
  source        String?  @default("nadlan")
  // The Tax Authority's OWN developer-vs-resale flags, and the classifier's
  // verdict column. These existed only on the live database — added by hand,
  // never here — so every fresh database was born without them and the
  // collector crashed on its first insert. Found when the quarterly scratch
  // collection failed on all three probe cities with "no such column":
  // the same writers-but-no-creator shape as nadlan_collection_status.
  // hok_hamecher matters most where yearBuilt comes back 0 (14-46% of deals
  // depending on the city): it is the only signal that can classify those
  // deals into the price series at all.
  hok_hamecher  Int?
  prev_deals    Int?
  class_source  String?
  // govmap's own per-deal id (dealId) — the only exact join a future address
  // backfill can use. Stored by the govmap writers since 8/2026 (it used to be
  // received and discarded); NULL on nadlan rows and on all legacy rows.
  // Live DB gets it via the guarded ALTER in lib/addressBackfillDb.ts — this
  // line only shapes fresh/build databases. NOT part of the deal identity key.
  source_deal_id String?
  captured_at   DateTime @default(now())

  @@index([city_name, deal_year, room_bucket], map: "idx_nadlan_tx_city_year_room")
  // The home page counts active deals by year and by date, and neither can use
  // the composite above (it leads with city_name) — so each render was two full
  // scans of ~1.35M rows. These two cover exactly those predicates.
  @@index([deal_date], map: "idx_nadlan_tx_deal_date")
  @@index([excluded, deal_year], map: "idx_nadlan_tx_excluded_year")
}

// Read-optimized aggregate the price graphs consume: per city × year × room_bucket,
// for scope "all" and "secondhand". Populated by scripts/aggregate-nadlan-transactions.ts.
model nadlan_year_room_stats {
  id            Int      @id @default(autoincrement())
  city_name     String
  year          Int
  room_bucket   String // "3" | "4" | "5" | "all"
  scope         String // "all" | "secondhand"
  avg_price     Float?
  median_price  Float?
  avg_sqm       Float?
  median_sqm    Float?
  n             Int      @default(0)
  last_updated  DateTime @default(now())

  @@unique([city_name, year, room_bucket, scope], map: "ux_nadlan_year_room_stats")
  // /cities, /compare and the rankings scan by bucket+scope across all cities;
  // the unique index leads with city_name and cannot serve them.
  @@index([room_bucket, scope, year], map: "idx_stats_bucket_scope_year")
}
