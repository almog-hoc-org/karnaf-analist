  "city_facts": [
    { "city": "ירושלים", "category": "price_index", "fact": "מחוז ירושלים הוביל את שנתון העליות בתקופה אוקטובר-נובמבר 2025 עם זינוק שנתי של 9.4%, וזאת על רקע ירידה ארצית של -2.6% בשמונת החודשים שקדמו.", "source_url": "https://www.nadlancenter.co.il/article/13713", "source_name": "Nadlan Center", "published": "2026-01-15", "confidence": "high" },
    { "city": "ירושלים", "category": "price_index", "fact": "ברבעון פברואר 2026, ירושלים רשמה ירידה חודשית של -0.7% במדד מחירי הדירות, אך עדיין +4.0% בהשוואה לפברואר 2025.", "source_url": "https://www.cbs.gov.il/he/mediarelease/Madad/DocLib/2026/052/10_26_052b.pdf", "source_name": "CBS Press Release 052/2026", "published": "2026-03-15", "confidence": "high" },
    { "city": "ירושלים", "category": "transactions", "fact": "ירושלים הובילה את שנת 2025 במספר עסקאות יד שנייה: 3,727 דירות מול 3,833 ב-2024. בדירות חדשות נמכרו רק 1,191 דירות לעומת 2,957 ב-2024 — צניחה של ~60%.", "source_url": "https://www.bizportal.co.il/realestates/news/article/20027655", "source_name": "BizPortal — סיכום 2025", "published": "2026-02", "confidence": "high" },
    { "city": "ירושלים", "category": "transactions", "fact": "סוף ינואר 2026 — ירושלים החזיקה ב-10,370 דירות חדשות שטרם נמכרו, השנייה אחרי תל אביב-יפו (10,540).", "source_url": "https://klikatnadlan.co.il/cbssalesnovjan2026/", "source_name": "Klikat Nadlan / למ\"ס", "published": "2026-03", "confidence": "high" },
    { "city": "ירושלים", "category": "price_index", "fact": "במדד דצמבר 2024-ינואר 2025, ירושלים רשמה +3.0% חודשי — הזינוק החד ביותר בין המחוזות באותה תקופה.", "source_url": "https://www.broker-re.co.il/madaddirotdecemberjanuary25/", "source_name": "Broker-RE", "published": "2025-03", "confidence": "high" },
