# Weekly off-server backup — publishes both databases to GitHub Releases.
#
# Runs on the HOST, not in the container: it needs the gh CLI and reads the
# data directory directly at /var/lib/karnaf/data. Auth comes from
# /etc/karnaf/backup.env (chmod 600), which should contain:
#   GH_TOKEN=<a token with repo scope on the karnaf-analist repo>
#   KARNAF_BACKUP_AGE_RECIPIENT=age1…   (public key; app.db is skipped without it)
# The private key that opens app.db.gz.age stays with the operator, never here.

[Unit]
Description=Karnaf Analist — weekly off-server backup to GitHub Releases
Wants=network-online.target
After=network-online.target
OnFailure=karnaf-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/karnaf
Environment=KARNAF_DATA_DIR=/var/lib/karnaf/data
EnvironmentFile=-/etc/karnaf/backup.env
ExecStart=/usr/bin/bash scripts/publish-backup.sh
# a full snapshot + upload of ~60MB compressed should never take this long
TimeoutStartSec=30min
